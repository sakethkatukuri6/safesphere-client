# SafeSphere backend - local development environment template.
# Copy to .env and fill in for your machine. NEVER commit a filled-in .env.
# Every value below is a placeholder; nothing here is a real secret.
#
# The backend does not read .env automatically - it reads real environment
# variables. In PowerShell:  $env:PORT = "8080"
# In bash:                   export PORT=8080

# --- HTTP server ---
# Port for GET /health, POST /api/v1/*, and WSS /ws/v1/*. Default: 8080
PORT=8080

# --- Database (SQLite, M6) ---
# Path to the SQLite file, or ":memory:" for an ephemeral store.
# Ignored by git; created on first start.
SAFESPHERE_DB_PATH=backend/data/safesphere.db

# --- Evidence Vault (internal AES-256-GCM) ---
# Base64 of exactly 32 random bytes. Generate one with:
#   openssl rand -base64 32
# If unset, the backend generates an ephemeral key at startup and logs a
# warning. That is fine for local demos and useless for real evidence:
# encrypted blobs become unreadable when the process restarts.
# NEVER reuse a development value outside local development.
SAFESPHERE_EVIDENCE_KEY_BASE64=PLACEHOLDER_BASE64_32_BYTE_KEY

# --- Logging ---
# One of: trace, debug, info, warn, error
SAFESPHERE_LOG_LEVEL=info

# --- Explicitly NOT configured here ---
# No SMS gateway, no maps API key, no push credentials, no real auth
# provider, and no Professional App settings. Those are out of scope for
# the local Citizen-only demo; see backend/README.md.
